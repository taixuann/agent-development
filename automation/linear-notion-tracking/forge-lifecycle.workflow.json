      "width": 128
    },
    {
      "id": "harvester",
      "lane": "context",
      "col": 2,
      "type": "backend",
      "label": "Context Harvester",
      "sublabel": "AST & Linear overlaps",
      "tag": "agent:context",
      "width": 128
    },
    {
      "id": "worktree_scan",
      "lane": "sandbox",
      "col": 2,
      "type": "database",
      "label": "Worktree Scan",
