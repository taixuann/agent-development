    { "id": "phase_planning", "label": "Plan Audit & Push", "fromCol": 3, "toCol": 3, "variant": "emphasis" },
    { "id": "phase_executing", "label": "Autonomous Goal Supervision", "fromCol": 4, "toCol": 4, "variant": "emphasis" },
    { "id": "phase_delivery", "label": "Review Pass & Draft PR", "fromCol": 5, "toCol": 5, "variant": "emphasis" }
