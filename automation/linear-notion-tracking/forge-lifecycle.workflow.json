  "edges": [
    { "id": "e_capture_triage", "from": "user_idea", "to": "backlog_cluster", "variant": "default" },
    { "id": "e_triage_harvest", "from": "backlog_cluster", "to": "harvester", "label": "trigger agent:context", "variant": "emphasis" },
    { "id": "e_harvest_wtscan", "from": "harvester", "to": "worktree_scan", "variant": "default" },
    { "id": "e_wtscan_gate", "from": "worktree_scan", "to": "context_gate", "label": "report options + conflicts", "variant": "security" },
    { "id": "e_gate_approved", "from": "context_gate", "to": "plan_draft", "label": "human approves approach", "variant": "emphasis" },
    { "id": "e_draft_commit", "from": "plan_draft", "to": "plan_commit", "variant": "default" },
    { "id": "e_draft_audit", "from": "plan_draft", "to": "plan_audit", "label": "adversarial review", "variant": "emphasis" },
    { "id": "e_audit_gate", "from": "plan_audit", "to": "plan_gate", "label": "post plan link to Linear", "variant": "security" },
    { "id": "e_gate_sandbox", "from": "plan_gate", "to": "sandbox_lock", "label": "human approves plan", "variant": "emphasis" },
    { "id": "e_sandbox_exec", "from": "sandbox_lock", "to": "goal_supervisor", "label": "sandbox verified", "variant": "emphasis" },
    { "id": "e_exec_review", "from": "goal_supervisor", "to": "code_review", "label": "TDD tests green", "variant": "emphasis" },
    { "id": "e_review_pr", "from": "code_review", "to": "draft_pr_push", "label": "purge scratch & push", "variant": "emphasis" },
    { "id": "e_pr_gate", "from": "draft_pr_push", "to": "result_gate", "label": "post Draft PR link to Linear", "variant": "security" },
    { "id": "e_gate_merge", "from": "result_gate", "to": "merge_node", "label": "approve -> agent:merging", "variant": "emphasis" },
    { "id": "e_gate_cancel", "from": "result_gate", "to": "cancel_node", "label": "abandon -> Canceled", "variant": "security" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Backlog Absorption & Quota Fallbacks",
      "items": [
        "Backlog Idea Absorption: agent:context sweeps unstarted backlog issues, merges overlapping requirements, and marks absorbed issues as Duplicate on Linear.",
        "Decision Engine Fallback: If DE quota is exhausted, auto-routes to independent Codex audit session running the /audit-writing-plans rubric.",
        "Execution Fallback: If OpenCode Free Router is exhausted, auto-routes execution to Codex gpt-6-luna-high."
      ]
    },
    {
      "dot": "emerald",
      "title": "Guarantees & Superpowers",
      "items": [
        "Superpowers for OpenCode: Installed and active in OpenCode via plugin manager (superpowers@git).",
        "Strict Directory Sandbox: rev-parse assertion guarantees OpenCode and Codex execute strictly in ~/worktrees/ident.",
        "Graphify AST Verification: Zero hallucinated symbols or files in implementation plans."
      ]
    },
    {
      "dot": "violet",
      "title": "Execution Hygiene & Anti-Drift",
      "items": [
        "Anti-Drift Scope Review: check_scope_boundary_conformance alerts foreign modifications without blind auto-reverts.",
        "Physical Goal Supervisor: Autonomous execution runs up to 3 repair cycles against real test suites (swift test / CoreSelfCheck).",
        "Bounded Native Review: Exactly 1 pass of codex exec review --base and at most 1 fix cycle; prevents review thrashing.",
        "Zero Test Litter: Scratch and loose test scripts are purged prior to Draft PR publication."
      ]
    },
    {
      "dot": "amber",
      "title": "Merge & Canceled Lifecycle",
      "items": [
        "Squash & Merge (agent:merging): gh pr merge --squash, canonical git pull, github-repo-care doc updates, final sanity check, worktree prune, and auto-transition to Done.",
        "Canceled Issue Archive: Lingering worktrees are pruned immediately; WIP branches are archived remotely to archive/canceled/<ident> so zero work is lost."
      ]
    }
  ]
}