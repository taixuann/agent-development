    { "id": "planning_group", "label": "3-Step Plan Audit", "lane": "planning", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "exec_group", "label": "TDD Goal Supervisor (Max 3 cycles)", "lane": "executing", "fromCol": 4, "toCol": 5, "variant": "emphasis" },
